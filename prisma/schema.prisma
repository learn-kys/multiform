// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @map("_id")
  name           String
  email          String
  emailVerified  Boolean   @default(false)
  image          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt
  firstName      String
  middleName     String?
  lastName       String
  fatherFullName String
  dateOfBirth    DateTime
  jobTitle       String
  jobId          String
  phoneNumber    String
  sessions       Session[]
  accounts       Account[]
  CandidatePersonalInfo CandidatePersonalInfo[]
  CandidateEducationInfo CandidateEducationInfo[]


  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id @map("_id")
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id @map("_id")
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id @map("_id")
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("verification")
}

model CandidatePersonalInfo {
  id                      String           @id @map("_id")
  userId                  String
  user                    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  // personal information 
  gender                  String
  isMarried               Boolean
  motherFullName          String
  nationality             String
  // additional information
  domicileOfState         String
  domicileCertificateIssuingAuthority String
  domicileCertificateNumber String
  domicileCertificateIssueDate DateTime
  haveDisability          Boolean
  disabilityType          String?
  markOfVisibleIdentification String
  documentToUpload        String
  // crossponded address information
  CaddressLine1           String
  CaddressLine2           String?
  Ccountry                String
  CaddressCityOrDistrict  String
  CaddressState           String
  CaddressPincode         String
  // permanent address information
  PaddressLine1           String
  PaddressLine2           String?
  Pcountry                String
  PaddressCityOrDistrict  String
  PaddressState           String
  PaddressPincode         String
  // timestamps
  createdAt               DateTime @default(now())
  updatedAt               DateTime @default(now()) @updatedAt
}

model CandidateEducationInfo {
  id                      String           @id @map("_id")
  userId                  String
  user                    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  // 10th details
  tenth_board             String
  tenth_schoolOrInstitute String
  tenth_isPercentageOrCGPAOrGrade String
  tenth_marksObtained     String
  tenth_maximumMarks      String
  tenth_percentageOrCGPAOrGrade String
  tenth_passingYear       Int
  tenth_Division          String

  // 12th details
  twelfth_board             String
  twelfth_schoolOrInstitute String
  twelfth_isPercentageOrCGPAOrGrade String
  twelfth_marksObtained     String
  twelfth_maximumMarks      String
  twelfth_percentageOrCGPAOrGrade String
  twelfth_passingYear       Int
  twelfth_Division          String

  // graduation details
  graduation_qualificationDegree String
  graduation_institute String
  graduation_subject String
  graduation_monthAndYearPassing String
  graduation_isPercentageOrCGPAOrGrade String
  graduation_marksObtained String
  graduation_maximumMarks String
  graduation_percentageOrCGPAOrGrade String

}